# radar/ is entirely generated: app/'s Vite build output, the JSON files
# npm run conv writes (radar/data.json, radar/releases/**), and the QA
# reports under radar/qa/** (npm run qa - coverage, junit/ctrf/allure,
# jsdoc, sbom) - see CLAUDE.md. old/ is the legacy vanilla-JS radar's
# hand-maintained shell (index.html, css/, js/, bootstrap/,
# deprecated.html) plus its own generated bits (config.json, releases/,
# html/ - covered above).
radar/

# c8's raw per-process V8 coverage dumps (test:coverage's working data,
# not the report itself) - kept outside radar/qa/coverage/ so it never
# gets deployed alongside the actual HTML/lcov report (.c8rc.json's
# temp-directory)
.c8-tmp/

mcp/dist